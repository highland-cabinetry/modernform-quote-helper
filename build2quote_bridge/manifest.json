{
  "manifest_version": 3,
  "name": "Modernform Build2Quote Bridge",
  "version": "1.0.1",
  "key": "",
  "description": "Locally fills and verifies LTL quote forms from Modernform Quote Helper without booking shipments.",
  "action": { "default_title": "Modernform Build2Quote Bridge" },
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://trax.tqlapp.com/*",
    "https://trax.tql.com/*",
    "https://mytms.us.dsv.com/*",
    "https://www.odfl.com/*",
    "https://*.b2clogin.com/*",
    "https://login.microsoftonline.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*", "http://localhost/*"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://trax.tqlapp.com/*",
        "https://trax.tql.com/*",
        "https://mytms.us.dsv.com/*",
        "https://www.odfl.com/*",
        "https://*.b2clogin.com/*",
        "https://login.microsoftonline.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
